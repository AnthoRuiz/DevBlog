# Configuration template. Copy it to .env and fill in the values:  cp .env.example .env
# Variables marked [REQUIRED] have no default: docker compose refuses to start if they are missing.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# [REQUIRED] database user, password (strong and unique) and database name
POSTGRES_USER=devblog_user
POSTGRES_PASSWORD=
POSTGRES_DB=devblog
# Host port (listens on 127.0.0.1 only)
POSTGRES_PORT=5432

# ── Application ───────────────────────────────────────────────────────────────
# [REQUIRED] generate one with: openssl rand -hex 32
SECRET_KEY=
# [REQUIRED] production | development
ENVIRONMENT=production
DEBUG=False

# ── Initial admin ─────────────────────────────────────────────────────────────
# Created only if no ADMIN exists. If ADMIN_PASSWORD is empty, a random password is
# generated and shown once in `docker logs devblog_backend`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Role switcher for local testing. NEVER enable it on a public deployment.
ALLOW_ROLE_SELF_SWITCH=False

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# [REQUIRED] tunnel token (Cloudflare Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# ── AI providers (optional) ───────────────────────────────────────────────────
# Used for translation, tag suggestions, reading time and tag-section validation.
# Configure one or both: they are tried in LLM_PROVIDER_ORDER and the next one takes over
# if a provider fails. With none, translation is disabled and the rest use keyword fallbacks.
# Claude: https://console.anthropic.com/  ·  Gemini: https://aistudio.google.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# One or more Gemini models, tried in order (each has its own free-tier quota)
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
LLM_PROVIDER_ORDER=claude,gemini

# ── Daily AI drafts (optional) ────────────────────────────────────────────────
# Two drafts a day for the admin to review (see docs/ARCHITECTURE_E2E.md §4.12)
AI_DRAFTS_TIME=16:00
AI_DRAFTS_TIMEZONE=America/Los_Angeles
# Unsplash Access Key for draft covers: https://unsplash.com/developers (the Secret Key is not needed)
UNSPLASH_ACCESS_KEY=
# Optional: enables POST /api/v1/ai-drafts/ingest for external generators (openssl rand -hex 24)
AI_DRAFTS_API_KEY=
