# Plantilla de configuración. Copia a .env y completa los valores:  cp .env.example .env
# Las variables marcadas como [OBLIGATORIA] no tienen valor por defecto: si faltan, docker compose no arranca.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# [OBLIGATORIA] usuario, contraseña (fuerte y única) y nombre de la base de datos
POSTGRES_USER=devblog_user
POSTGRES_PASSWORD=
POSTGRES_DB=devblog
# Puerto del host (solo escucha en 127.0.0.1)
POSTGRES_PORT=5432

# ── Aplicación ────────────────────────────────────────────────────────────────
# [OBLIGATORIA] genera una con: openssl rand -hex 32
SECRET_KEY=
# [OBLIGATORIA] production | development
ENVIRONMENT=production
DEBUG=False

# ── Admin inicial ─────────────────────────────────────────────────────────────
# Se crea solo si no existe ningún ADMIN. Si ADMIN_PASSWORD queda vacía se genera una
# aleatoria y se muestra una sola vez en `docker logs devblog_backend`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Selector de roles para pruebas locales. NUNCA activarlo en un despliegue público.
ALLOW_ROLE_SELF_SWITCH=False

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# [OBLIGATORIA] token del túnel (Cloudflare Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Google Gemini AI (opcional) ───────────────────────────────────────────────
# Obtén una clave en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
