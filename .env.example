# PostgreSQL Database
POSTGRES_USER=devblog_user
POSTGRES_PASSWORD=devblog_secure_pass_2026
POSTGRES_DB=devblog
POSTGRES_PORT=5432

# Application Settings
# Genera una clave con: openssl rand -hex 32  (con ENVIRONMENT=production el backend no arranca con una clave por defecto)
SECRET_KEY=
ENVIRONMENT=development
DEBUG=False

# Admin inicial (se crea solo si no existe ningún ADMIN).
# Si ADMIN_PASSWORD queda vacía se genera una aleatoria y se muestra una vez en `docker logs devblog_backend`.
# Si un admin existente aún usa la contraseña antigua por defecto, se rota a este valor al arrancar.
ADMIN_EMAIL=admin@devblog.local
ADMIN_PASSWORD=

# Selector de roles para pruebas locales. NUNCA activarlo en un despliegue público.
ALLOW_ROLE_SELF_SWITCH=False

# Cloudflare Tunnel (servicio `tunnel` en docker-compose)
CLOUDFLARE_TUNNEL_TOKEN=

# Google Gemini AI API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
