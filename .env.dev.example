# Development environment template (docker-compose.dev.yml).
# Copy it and fill in the values:  cp .env.dev.example .env.dev
# Use different secrets than production; this database only holds test data.

# ── PostgreSQL (dev) ──────────────────────────────────────────────────────────
POSTGRES_USER=devblog_dev
POSTGRES_PASSWORD=
POSTGRES_DB=devblog_dev
# Host port (production uses 5432)
POSTGRES_PORT=5433

# ── Application ───────────────────────────────────────────────────────────────
# Generate one with: openssl rand -hex 32
SECRET_KEY=
# Host port for the dev backend (production uses 8000)
BACKEND_PORT=8001
DEBUG=True
# Seed the demo posts into the empty dev database
SEED_DEMO_POSTS=True

# ── Initial admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@devblog.local
ADMIN_PASSWORD=

# Role switcher for testing permissions (also build the frontend with VITE_ENABLE_ROLE_TESTING=true)
ALLOW_ROLE_SELF_SWITCH=False

# ── AI providers (optional, tried in LLM_PROVIDER_ORDER) ──────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
LLM_PROVIDER_ORDER=claude,gemini

# ── Daily writing ideas (optional) ────────────────────────────────────────────
# Two researched topics a day for the admin to write about (see docs/ARCHITECTURE_E2E.md §4.12)
AI_DRAFTS_TIME=16:00
AI_DRAFTS_TIMEZONE=America/Los_Angeles
# Unsplash Access Key for idea covers: https://unsplash.com/developers (the Secret Key is not needed)
UNSPLASH_ACCESS_KEY=
# Optional: enables POST /api/v1/ideas/ingest for external generators (openssl rand -hex 24)
AI_DRAFTS_API_KEY=
